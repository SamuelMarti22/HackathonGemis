GEMINI_API_KEY=tu_api_key_aqui
# gemini-flash-latest resuelve al modelo más nuevo, con cuota gratuita muy
# baja (~20 req/día). gemini-3.6-flash es el que recomienda la propia API
# para keys nuevas y tiene cuota gratuita razonable.
CHAT_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
RETRIEVAL_TOP_K=6
MIN_SIMILARITY=0.55

MONGO_URI=mongodb://localhost:27019
MONGO_DB=tutor_juridico

# Postgres + pgvector (RAG: fragmentos indexados de la Constitución)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/tutor_juridico
