GEMINI_API_KEY=tu_api_key_aqui
# Los modelos "flash" (gemini-flash-latest, gemini-3.6-flash, ...) tienen
# sólo 20 requests/día gratis en una key nueva. "flash-lite" tiene cuota
# gratuita mucho más generosa y sigue dando buena calidad para este caso de uso.
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
RETRIEVAL_TOP_K=6
MIN_SIMILARITY=0.55

MONGO_URI=mongodb://localhost:27019
MONGO_DB=tutor_juridico

# Postgres + pgvector (RAG: fragmentos indexados de la Constitución)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/tutor_juridico
